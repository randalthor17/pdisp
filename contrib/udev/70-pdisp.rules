# pdisp: let the logged-in user talk to an Android tablet or phone over USB without root.
# `pdispd -u` asks the device to switch to accessory mode (AOA), then streams over its bulk endpoints.
#
# Install:  sudo cp contrib/udev/70-pdisp.rules /etc/udev/rules.d/ && sudo udevadm control --reload && replug the device
# NixOS:    services.udev.extraRules = builtins.readFile ./contrib/udev/70-pdisp.rules;
# `uaccess` gives the user at the active seat access, so no group membership is needed.

# the device after it switched to accessory mode (Google's ids, with or without adb)
# the device before it switched: the common Android vendors (the switch request is sent to the device in its normal mode)
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", ATTR{idProduct}=="2d0[0-5]", TAG+="uaccess"
# Samsung
SUBSYSTEM=="usb", ATTR{idVendor}=="04e8", TAG+="uaccess"
# Google
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", TAG+="uaccess"
# Xiaomi
SUBSYSTEM=="usb", ATTR{idVendor}=="2717", TAG+="uaccess"
# Motorola
SUBSYSTEM=="usb", ATTR{idVendor}=="22b8", TAG+="uaccess"
# Huawei
SUBSYSTEM=="usb", ATTR{idVendor}=="12d1", TAG+="uaccess"
# OnePlus
SUBSYSTEM=="usb", ATTR{idVendor}=="2a70", TAG+="uaccess"
# Oppo
SUBSYSTEM=="usb", ATTR{idVendor}=="22d9", TAG+="uaccess"
# Vivo
SUBSYSTEM=="usb", ATTR{idVendor}=="2d95", TAG+="uaccess"
# Sony
SUBSYSTEM=="usb", ATTR{idVendor}=="0fce", TAG+="uaccess"
# LG
SUBSYSTEM=="usb", ATTR{idVendor}=="1004", TAG+="uaccess"
# HTC
SUBSYSTEM=="usb", ATTR{idVendor}=="0bb4", TAG+="uaccess"
# ZTE
SUBSYSTEM=="usb", ATTR{idVendor}=="19d2", TAG+="uaccess"
# Fairphone
SUBSYSTEM=="usb", ATTR{idVendor}=="2ae5", TAG+="uaccess"
# MediaTek
SUBSYSTEM=="usb", ATTR{idVendor}=="0e8d", TAG+="uaccess"
# Qualcomm
SUBSYSTEM=="usb", ATTR{idVendor}=="05c6", TAG+="uaccess"

# the virtual touchscreen and stylus pdispd creates for the device ("pdisp touchscreen", "pdisp stylus", and the ones the tests make): readable by the user at the
# active seat (evtest, the test suite), as a normal touchscreen is by the compositor. Nothing is writable: that stays with /dev/uinput.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="pdisp *", TAG+="uaccess"
